---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Btn from "../components/Btn.astro";
import Head from "../components/Head.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Cta from "../components/Cta.astro";
import SherpaShowcase from "../components/SherpaShowcase.astro";
import LogoBand from "../components/LogoBand.astro";
import { FORM, to } from "../lib/site";
const tiles = [
  { icon: "layers", label: "EUT-as-a-Service", href: "/partnerships#implementation-enablement" },
  { icon: "file", label: "Documentation-as-a-Service", href: "/partnerships#ams-enablement" },
  { icon: "users", label: "Oracle Resource Augmentation", href: "/partnerships#daas" },
  { icon: "cap", label: "Consulting Training", href: "/talent-pathways#corporate-fresher-training" },
  { icon: "monitor", label: "SHERPA platform", href: "/sherpa" },
];
---
<Layout
  path="/"
  title="User Enablement Partner for Oracle SIs | YourERPCoach"
  description="You implement Oracle. We get the users ready. Manuals, process videos, and key-user and end-user training for Oracle System Integrators, powered by SHERPA."
>
  <section class="hero hero-home">
    <div class="wrap">
      <p class="eyebrow">User enablement partner for Oracle SIs</p>
      <h1>You implement Oracle.<span class="tone"> We get the users ready.</span></h1>
      <p class="lead">Role-based manuals, process videos, and key-user and end-user training for Oracle Fusion programmes, powered by SHERPA.</p>
      <p class="serif tiles-title">How can YECC help?</p>
      <div class="tiles c5">
        {tiles.map((t) => <a href={to(t.href)}><Icon name={t.icon} /><span>{t.label}</span></a>)}
      </div>
      <div class="btns">
        <Btn href={FORM}>Explore SI Partnership</Btn>
        <Btn href="/sherpa" ghost>See how SHERPA works</Btn>
      </div>
    </div>
  </section>

  <LogoBand id="approach" />

  <Section id="partnership">
    <Head
      eyebrow="Oracle System Integrator Partnerships"
      title="Extend your delivery team| with a dedicated user enablement workstream."
      lead="YECC works alongside your implementation/ support team to turn client’s configured processes into step-by-step guides, videos, interactive video guides, and in-application learning, through SHERPA portal."
    />
    <div class="grid c2">
      <Card
        title="SHERPA during Implementation" icon="layers" num="01" href="/partnerships#implementation-enablement"
        text="Bring YECC into your implementation workstream to manage documentation and user enablement from project kick-off through go-live."
        bullets={[
          "**Early enablement of client users** through the access to vanilla process guides and videos",
          "**Capture client’s configured processes** as soon as the project configurations are approved",
          "**Prepare key users** before the wider end-user rollout through client-specific training documentation and videos",
          "**Deliver role-based** guides, process videos, and **training** for client’s end users",
          "Launch **SHERPA as the user knowledge hub** (for training delivery as well as authoring for maintenance) for go-live",
        ]}
      />
      <Card
        title="SHERPA during Support" icon="refresh" num="02" href="/partnerships#ams-enablement"
        text="Extend your post-go-live support/ AMS services with ongoing user enablement, refresher training, and updated documentation as the processes evolve with quarterly Oracle Cloud ERP releases."
        bullets={[
          "**Upload the existing static user guide Word docs or PDFs** to SHERPA to convert them into dynamic, maintainable guides and videos",
          "**Update the client-specific guides and process videos** in the easiest possible way: change only what needs to be fixed, and it gets published automatically",
          "**Deliver training** for affected roles and users, as the processes, workflows and screens evolve",
          "**Keep current guidance always available** for new joiners and existing employees through SHERPA portal",
        ]}
      />
    </div>
  </Section>

  <Section id="sherpa" class="bg-navy"><SherpaShowcase /></Section>

  <Cta eyebrow="Ready to strengthen your delivery?" title="Add a dedicated enablement workstream to your Oracle delivery.">
    <Btn href={FORM}>Contact the YECC Team</Btn>
  </Cta>
</Layout>
