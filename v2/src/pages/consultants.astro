---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Btn from "../components/Btn.astro";
import Cta from "../components/Cta.astro";
import LogoBand from "../components/LogoBand.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Head from "../components/Head.astro";
import Checks from "../components/Checks.astro";
import { Image } from "astro:assets";
import appScreens from "../assets/app/app-screens.png";
import googlePlay from "../assets/app/google-play.png";
import appStore from "../assets/app/app-store.png";
import { APP, APP_STORE, PLAY_STORE, ECAMPUS, LOGIN, to, isExternal } from "../lib/site";
const tiles = [
  { icon: "users", label: "Fresher Training Cohorts", href: "/upcoming-cohorts" },
  { icon: "video", label: "Self-paced Courses", href: "/courses" },
  { icon: "app", label: "Mobile App", href: APP },
  { icon: "cap", label: "eCampus", href: ECAMPUS },
];
---
<Layout
  path="/consultants"
  title="Oracle Cloud ERP Training for Consultants | YECC"
  description="Fresher training cohorts, self-paced Oracle Cloud ERP courses, the YECC mobile app, and eCampus for Oracle consultants and aspiring consultants."
>
  {/* Same layout as the home page hero, aimed at consultants instead of SIs, in blue so the two sides read apart. */}
  <section class="hero hero-home hero-alt">
    <div class="wrap">
      <p class="eyebrow">YECC for Oracle Consultants</p>
      <h1>Start your Oracle career.<span class="tone"> Grow it with YECC.</span></h1>
      <p class="lead">Live cohorts, self-paced courses, and learning on the go, built by Oracle consultants who train SI teams.</p>
      <p class="serif tiles-title">How can YECC help you?</p>
      <div class="tiles">
        {tiles.map((t) => <a href={to(t.href)} {...(isExternal(t.href) ? { target: "_blank", rel: "noopener" } : {})}><Icon name={t.icon} /><span>{t.label}</span></a>)}
      </div>
      <div class="btns">
        <Btn href="/upcoming-cohorts">View Upcoming Cohorts</Btn>
        <Btn href="/courses" ghost>Browse Self-paced Courses</Btn>
      </div>
    </div>
  </section>

  <LogoBand />

  <Section id="learn">
    <Head
      eyebrow="Oracle Cloud ERP learning"
      title="Everything you need| to become project-ready."
      lead="Pick the format that fits where you are: a guided cohort, courses at your own pace, the app in your pocket, or eCampus at your college."
    />
    <div class="grid c4">
      <Card
        title="Cohorts" icon="users" num="01" href="/upcoming-cohorts"
        text="Eight-week fresher training cohorts with expert-led sessions, Oracle demo-system access, and interview preparation."
      />
      <Card
        title="Self-paced Courses" icon="video" num="02" href="/courses"
        text="ERP fundamentals, business processes, and Oracle Cloud ERP functional modules, at your own pace."
      />
      <Card
        title="Mobile App" icon="app" num="03" href={APP}
        text="Upskill with courses and quizzes, and browse Oracle job openings, all on your phone."
      />
      <Card
        title="eCampus" icon="cap" num="04" href={ECAMPUS}
        text="YECC’s extended college campus: ERP basics, certification, and visibility with recruiters for graduates getting ready for placements."
      />
    </div>
  </Section>

  <Section id="get-the-app" class="bg-tint">
    <div class="split">
      <div>
        <Head
          eyebrow="YECC mobile app"
          title="Learn, practise, and find| Oracle roles on the go."
          lead="The YourERPCoach app keeps your learning and your next career move in one place."
        />
        <Checks items={[
          "**Upskill** with your courses and process videos",
          "**Check your understanding** with quizzes that explain every answer",
          "**Find work** through Oracle consulting openings from SIs and consulting firms",
        ]} />
        <div class="stores">
          <a href={PLAY_STORE} target="_blank" rel="noopener"><Image src={googlePlay} alt="Get it on Google Play" height={48} /></a>
          <a href={APP_STORE} target="_blank" rel="noopener"><Image src={appStore} alt="Download on the App Store" height={48} /></a>
        </div>
      </div>
      <Image class="app-shots" src={appScreens} alt="YECC app screens: Oracle job openings, a quiz with its explanation, and process video courses" widths={[560, 840, 1120]} sizes="(min-width: 960px) 560px, 100vw" />
    </div>
  </Section>

  <Cta eyebrow="Ready to start?" title="Join the next cohort and build a career in Oracle Cloud ERP consulting.">
    <Btn href="/upcoming-cohorts">View Upcoming Cohorts</Btn>
    <Btn href={LOGIN} ghost>Sign in</Btn>
  </Cta>
</Layout>
