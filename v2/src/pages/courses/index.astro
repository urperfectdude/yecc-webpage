---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import TextLink from "../../components/TextLink.astro";
import courses from "../../data/courses.json";
import { LOGIN, to } from "../../lib/site";

// Short catalog blurbs in catalog order, grouped for the filter. Everything else comes from courses.json.
const catalog = [
  { slug: "erp-business-processes-overview", topic: "ERP foundations", text: "Start your ERP consulting journey with an overview of essential business processes." },
  { slug: "basics-of-erp-2024", topic: "ERP foundations", text: "A beginner-friendly introduction to ERP, its functional areas, and consulting foundations." },
  { slug: "oracle-cloud-p2p-fast-track-course", topic: "Oracle Financials", text: "Covers Oracle Cloud ERP common concepts, General Accounting, Payables, Procurement basics, and Cash Management." },
  { slug: "oracle-cloud-expense", topic: "Oracle Financials", text: "Training on Oracle Cloud Expense module processes and setups." },
  { slug: "oracle-cloud-scm-process-course", topic: "Oracle Supply Chain", text: "Training on Oracle Cloud SCM processes, excluding setups." },
  { slug: "oracle-cloud-erp-basics-and-general-accounting-2025-26", topic: "Oracle Financials", text: "Key concepts in Oracle Cloud ERP common topics and General Accounting." },
  { slug: "oracle-cloud-erp-accounts-payable-2025-26", topic: "Oracle Financials", text: "Fundamentals of Oracle Cloud Accounts Payable and P2P concepts from the Payables side." },
  { slug: "oracle-cloud-erp-cash-management-2025-26", topic: "Oracle Financials", text: "Fundamentals of the Oracle Cloud Cash Management module." },
  { slug: "oracle-cloud-erp-accounts-receivable-2025-26", topic: "Oracle Financials", text: "Fundamentals of the Oracle Cloud Accounts Receivable module." },
  { slug: "oracle-cloud-erp-fixed-assets-2025-26", topic: "Oracle Financials", text: "Fundamentals of the Oracle Cloud Fixed Assets module." },
].map((item) => ({ ...item, course: courses.find((c) => c.slug === item.slug)! }));
const topics = [...new Set(catalog.map((c) => c.topic))];

const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/courses/*", { eager: true });
const art = (name: string) => images[`../../assets/courses/${name}`]?.default;
const videos = (content: string) => content.split(" · ")[0];
---
<Layout
  path="/courses"
  title="Self-paced Oracle Cloud ERP Courses | YECC"
  description="Explore YECC self-paced courses covering ERP fundamentals, business processes, and Oracle Cloud ERP functional modules."
>
  <div class="wrap catalog">
    <header class="catalog-head">
      <div>
        <p class="eyebrow">Self-paced courses</p>
        <h1>Build practical Oracle Cloud ERP skills<span class="tone"> at your own pace.</span></h1>
      </div>
      <p class="muted">{catalog.length} courses · recorded lessons and assessments</p>
    </header>

    <div class="filters" role="toolbar" aria-label="Filter courses by topic" data-filters>
      <button type="button" class="on" data-topic="" aria-pressed="true">All</button>
      {topics.map((t) => <button type="button" data-topic={t} aria-pressed="false">{t}</button>)}
    </div>

    <div class="course-grid" id="course-catalog">
      {catalog.map((item, i) => {
        const image = art(item.course.thumbnail);
        return (
          <a class="course-card reveal" href={to(`/courses/${item.slug}`)} data-topic={item.topic} style={`--d:${(i % 3) * 70}ms`}>
            <div class="course-card-art">{image && <Image src={image} alt="" width={640} />}</div>
            <div class="course-card-body">
              <p class="course-card-topic">{item.topic}</p>
              <h2>{item.course.title}</h2>
              <p class="course-card-text">{item.text}</p>
              <div class="course-card-foot">
                <span class="muted">
                  <Icon name="video" />{videos(item.course.content)}
                  <Icon name="clock" />{item.course.duration.replace(" Hours", " hrs")}
                </span>
                <strong>{item.course.price}</strong>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <p class="catalog-foot muted">Already enrolled? <TextLink href={LOGIN}>Consultant Login</TextLink></p>
  </div>
</Layout>
