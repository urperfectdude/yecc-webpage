---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
import TextLink from "../../components/TextLink.astro";
import Head from "../../components/Head.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import Cta from "../../components/Cta.astro";
import courses from "../../data/courses.json";
import { LOGIN } from "../../lib/site";

// Short catalog blurbs and stats, in catalog order. Prices and the detail pages come from courses.json.
const catalog = [
  { slug: "erp-business-processes-overview", text: "Start your ERP consulting journey with an overview of essential business processes.", stats: ["11:40 Hrs", "21 Videos", "21 Tests"] },
  { slug: "basics-of-erp-2024", text: "A beginner-friendly introduction to ERP, its functional areas, and consulting foundations.", stats: ["04:56 Hrs", "10 Videos", "10 Tests"] },
  { slug: "oracle-cloud-p2p-fast-track-course", text: "Covers Oracle Cloud ERP common concepts, General Accounting, Payables, Procurement basics, and Cash Management.", stats: ["37:18 Hrs", "69 Videos", "4 GLP"] },
  { slug: "oracle-cloud-expense", text: "Training on Oracle Cloud Expense module processes and setups.", stats: ["15:00 Hrs", "23 Videos", "17 Tests"] },
  { slug: "oracle-cloud-scm-process-course", text: "Training on Oracle Cloud SCM processes, excluding setups.", stats: ["10:00 Hrs", "24 Videos", "23 Tests"] },
  { slug: "oracle-cloud-erp-basics-and-general-accounting-2025-26", text: "Key concepts in Oracle Cloud ERP common topics and General Accounting.", stats: ["28:11 Hrs", "35 Videos", "35 Tests"] },
  { slug: "oracle-cloud-erp-accounts-payable-2025-26", text: "Fundamentals of Oracle Cloud Accounts Payable and P2P concepts from the Payables side.", stats: ["24:23 Hrs", "27 Videos", "27 Tests"] },
  { slug: "oracle-cloud-erp-cash-management-2025-26", text: "Fundamentals of the Oracle Cloud Cash Management module.", stats: ["6:38 Hrs", "7 Videos", "7 Tests"] },
  { slug: "oracle-cloud-erp-accounts-receivable-2025-26", text: "Fundamentals of the Oracle Cloud Accounts Receivable module.", stats: ["19:39 Hrs", "20 Videos", "20 Tests"] },
  { slug: "oracle-cloud-erp-fixed-assets-2025-26", text: "Fundamentals of the Oracle Cloud Fixed Assets module.", stats: ["18:13 Hrs", "20 Videos", "20 Tests"] },
].map((item) => ({ ...item, course: courses.find((c) => c.slug === item.slug)! }));
---
<Layout
  path="/courses"
  title="Self-paced Oracle Cloud ERP Courses | YECC"
  description="Explore YECC self-paced courses covering ERP fundamentals, business processes, and Oracle Cloud ERP functional modules."
>
  <Hero
    eyebrow="Self-paced courses"
    title="Build practical Oracle Cloud ERP skills| at your own pace."
    lead="Explore YECC courses covering ERP fundamentals, business processes, and Oracle Cloud ERP functional modules."
  >
    <Btn href="#course-catalog">Explore all courses</Btn>
    <Btn href={LOGIN} ghost>Consultant Login</Btn>
  </Hero>

  <Section id="course-catalog">
    <Head eyebrow="Course catalog" title="All self-paced courses." lead="Select a course to build focused capability through recorded lessons and assessments." />
    <div class="grid c3">
      {catalog.map((item, i) => (
        <Card title={item.course.title} text={item.text}>
          <Fragment slot="top">
            <span class="num">Course {String(i + 1).padStart(2, "0")}</span>
            <span class="price">{item.course.price}</span>
          </Fragment>
          <div class="stats">{item.stats.map((s) => <span>{s}</span>)}</div>
          <TextLink href={`/courses/${item.slug}`}>Explore course</TextLink>
        </Card>
      ))}
    </div>
  </Section>

  <Cta eyebrow="Continue learning" title="Access your YECC account to explore and enrol in a course.">
    <Btn href={LOGIN}>Consultant Login</Btn>
  </Cta>
</Layout>
