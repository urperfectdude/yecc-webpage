---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Btn from "../../components/Btn.astro";
import Checks from "../../components/Checks.astro";
import courses from "../../data/courses.json";
import { LOGIN } from "../../lib/site";

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}
const c = Astro.props.course as (typeof courses)[number];
// Course artwork and instructor photos, looked up by the file names stored in courses.json.
const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/courses/*", { eager: true });
const image = (name?: string) => (name ? images[`../../assets/courses/${name}`]?.default : undefined);
const thumbnail = image(c.thumbnail);
const photo = image(c.photo);

const lessonIcon: Record<string, string> = { video: "video", test: "file", assignment: "book" };
const instructor = c.instructor?.replace(", YECC", "");
const lessons = c.modules.reduce((n, m) => n + m.lessons.length, 0);
const description = c.description.split(". ")[0] + ".";
const schema = {
  "@type": "Course",
  name: c.title,
  description,
  provider: { "@type": "Organization", name: "YourERPCoach", sameAs: LOGIN },
  offers: { "@type": "Offer", category: "Paid", price: c.price.replace(/[^\d]/g, ""), priceCurrency: "INR", url: c.url },
  hasCourseInstance: { "@type": "CourseInstance", courseMode: "Online", courseWorkload: c.duration },
};
---
<Layout path="/courses" title={`${c.title} | YECC Self-paced Course`} description={description} schema={schema}>
  <div class="wrap course">
    <header class="course-intro">
      <p class="eyebrow">Self-paced course</p>
      <h1>{c.title}</h1>
      <ul class="course-meta">
        {instructor && <li><Icon name="users" />{instructor}</li>}
        <li><Icon name="video" />{c.content}</li>
        <li><Icon name="clock" />{c.duration}</li>
      </ul>
    </header>

    <aside class="course-aside" aria-label="Enrol">
      <div class="buy">
        {thumbnail && (
          <div class="buy-art"><Image src={thumbnail} alt={`${c.title} course artwork`} width={680} loading="eager" /></div>
        )}
        <div class="buy-body">
          <p class="buy-price">
            <strong>{c.price}</strong>
            {c.original && <s>{c.original}</s>}
            {c.off && <em>{c.off}</em>}
          </p>
          <span data-buy-anchor><Btn href={c.url}>Buy Now</Btn></span>
          <ul class="buy-list">{c.includes.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}</ul>
        </div>
      </div>
    </aside>

    <div class="course-main">
      <section class="course-part reveal" id="about">
        <h2>About this course</h2>
        <div class="more" data-more>
          <p>{c.description}</p>
          <button type="button" aria-expanded="false"><span>Read more</span><Icon name="chevron" /></button>
        </div>
        {c.mode && <p class="muted mt-4">Delivered as: {c.mode}</p>}
      </section>

      <section class="course-part reveal">
        <h2>Who it is for</h2>
        <Checks items={c.ideal} />
      </section>

      <section class="course-part reveal" id="course-content">
        <div class="curriculum-head">
          <h2>Course content</h2>
          <button type="button" class="text-btn" data-expand-all>Expand all</button>
        </div>
        <p class="muted mb-4">
          {c.modules.length} module{c.modules.length > 1 ? "s" : ""} · {lessons} items · {c.duration}
        </p>
        {c.modules.map((m, i) => (
          <details class="module" open={i === 0}>
            <summary>
              <span><strong>{m.name}</strong><small>{m.count} · {m.total.replace("Total ", "")}</small></span>
              <Icon name="chevron" />
            </summary>
            <ul>
              {m.lessons.map((l) => (
                <li>
                  <Icon name={lessonIcon[l.kind]} />
                  <span>{l.title}{l.preview && <em>Preview</em>}</span>
                  <small>{l.meta}</small>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>

      {c.bio.length > 0 && (
        <section class="course-part reveal">
          <h2>Your instructor</h2>
          <div class="person">
            {photo && <Image src={photo} alt="" width={128} height={128} />}
            <div>
              <strong>{instructor}</strong>
              {c.linkedin && <a href={c.linkedin} target="_blank" rel="noopener">LinkedIn<Icon name="go" /></a>}
            </div>
          </div>
          <Checks items={c.bio} />
        </section>
      )}

      {c.why.length > 0 && (
        <section class="course-part reveal">
          <h2>Why YECC courses are different</h2>
          {c.why.map((p) => <p class="mb-4">{p}</p>)}
        </section>
      )}
    </div>
  </div>

  <div class="buy-bar" inert>
    <strong>{c.price}</strong>
    <Btn href={c.url}>Buy Now</Btn>
  </div>
</Layout>
