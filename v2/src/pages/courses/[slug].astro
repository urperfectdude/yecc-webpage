---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Btn from "../../components/Btn.astro";
import TextLink from "../../components/TextLink.astro";
import Head from "../../components/Head.astro";
import Section from "../../components/Section.astro";
import Checks from "../../components/Checks.astro";
import Chips from "../../components/Chips.astro";
import Cta from "../../components/Cta.astro";
import courses from "../../data/courses.json";
import { LOGIN } from "../../lib/site";

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}
const c = Astro.props.course as (typeof courses)[number];
// Course artwork and instructor photos, looked up by the file names stored in courses.json.
const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/courses/*", { eager: true });
const image = (name?: string) => (name ? images[`../../assets/courses/${name}`]?.default : undefined);
const thumbnail = image(c.thumbnail);
const photo = image(c.photo);

const facts = [["Instructor", c.instructor], ["Course content", c.content], ["Total duration", c.duration], ["Mode of delivery", c.mode]].filter(([, v]) => v) as string[][];
const lessonIcon: Record<string, string> = { video: "video", test: "file", assignment: "book" };
const moduleCount = c.modules.length;
const instructor = c.instructor?.replace(", YECC", "");
const description = c.description.split(". ")[0] + ".";
const schema = {
  "@type": "Course",
  name: c.title,
  description,
  provider: { "@type": "Organization", name: "YourERPCoach", sameAs: LOGIN },
  offers: { "@type": "Offer", category: "Paid", price: c.price.replace(/[^\d]/g, ""), priceCurrency: "INR", url: c.url },
  hasCourseInstance: { "@type": "CourseInstance", courseMode: "Online", courseWorkload: c.duration },
};
---
<Layout path="/courses" title={`${c.title} | YECC Self-paced Course`} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid split">
        <div>
          <p class="eyebrow">Self-paced course</p>
          <h1>{c.title}</h1>
          <Chips items={facts.slice(0, 3).map(([, v]) => v)} />
          <div class="btns">
            <Btn href={c.url}>Buy Now</Btn>
            <Btn href="#course-content" ghost>View course content</Btn>
          </div>
        </div>
        <div class="buy">
          <p class="buy-price">
            <strong class="serif">{c.price}</strong>
            {c.original && <s>{c.original}</s>}
            {c.off && <em>{c.off}</em>}
          </p>
          <Btn href={c.url}>Buy Now</Btn>
          <h3>This course includes</h3>
          <Checks items={c.includes} />
        </div>
      </div>
    </div>
  </section>

  <Section id="about">
    <div class="split items-start">
      <div>
        <p class="eyebrow">About this course</p>
        <p class="lead">{c.description}</p>
        <dl class="facts mt-8">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd class="small">{v}</dd></div>)}
        </dl>
      </div>
      {thumbnail && <Image class="thumb" src={thumbnail} alt={`${c.title} course artwork`} width={880} />}
    </div>
  </Section>

  <Section class="bg-tint">
    <Head eyebrow="Who it is for" title="This course| is ideal for" />
    <Checks class="ideal" items={c.ideal} />
  </Section>

  <Section id="course-content">
    <Head
      eyebrow="Course content"
      title={`${c.content.replaceAll(" · ", ", ")}| across ${moduleCount} module${moduleCount > 1 ? "s" : ""}.`}
      lead={`Total duration: ${c.duration}`}
    />
    {c.modules.map((m, i) => (
      <details class="module" open={i === 0}>
        <summary>
          <span><strong>{m.name}</strong><small>{m.total} · {m.count}</small></span>
          <Icon name="chevron" />
        </summary>
        <ul>
          {m.lessons.map((l) => (
            <li>
              <Icon name={lessonIcon[l.kind]} />
              <span>{l.title}{l.preview && <em>Preview</em>}</span>
              <small>{l.meta}</small>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </Section>

  {c.bio.length > 0 && (
    <Section class="bg-navy">
      <div class="split">
        <div class="person">
          {photo && <Image src={photo} alt={instructor ?? ""} width={224} height={224} />}
          <div>
            <p class="eyebrow">Instructor profile</p>
            <h2>{instructor}</h2>
            {c.linkedin && <p class="mt-2.5 mb-0"><TextLink href={c.linkedin}>LinkedIn profile</TextLink></p>}
          </div>
        </div>
        <Checks items={c.bio} />
      </div>
    </Section>
  )}

  {c.why.length > 0 && (
    <Section>
      <Head title="Why YECC courses| are different?" />
      <div class="why">{c.why.map((p) => <p>{p}</p>)}</div>
    </Section>
  )}

  <Cta eyebrow="Continue learning" title="Access your YECC account to explore and enrol in a course.">
    <Btn href={c.url}>Buy Now</Btn>
    <Btn href={LOGIN} ghost>Consultant Login</Btn>
  </Cta>
</Layout>
