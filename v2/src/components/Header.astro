---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Btn from "./Btn.astro";
import logo from "../assets/logo.png";
import { NAV, CONSULTANT_NAV, CONSULTANT_PATHS, LOGIN, APP, to, isExternal } from "../lib/site";
const { path } = Astro.props as { path: string };
const current = (href: string) => href.split("#")[0] === path;
// Each audience gets its own menu, plus a plain link across to the other audience's landing page.
const consultant = CONSULTANT_PATHS.includes(path);
const nav = consultant ? CONSULTANT_NAV : NAV;
const other = consultant ? { label: "YECC for SIs", href: "/" } : { label: "YECC for Oracle Consultants", href: "/consultants" };
---
<header class="header">
  <div class="wrap">
    <a class="logo" href={to("/")} aria-label="YourERPCoach.com home">
      <Image src={logo} alt="YourERPCoach.Com" width={434} loading="eager" />
    </a>
    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false">
      <span class="bars"><Icon name="menu" /></span>
      <span class="x"><Icon name="close" /></span>
    </button>
    <div class="header-panel">
      <nav class="nav" aria-label="Main">
        {nav.map((item) =>
          item.children ? (
            <div class="nav-item">
              <button type="button" aria-expanded="false" class:list={{ current: item.children.some((c) => current(c.href)) }}>
                {item.label}<Icon name="chevron" />
              </button>
              <div class="dropdown">
                {/* A child that starts a new group gets a small label above it. */}
                {item.children.map((c, i) => <>
                  {c.group && c.group !== item.children![i - 1]?.group && <span class="dropdown-label">{c.group}</span>}
                  <a href={to(c.href)}>{c.label}</a>
                </>)}
              </div>
            </div>
          ) : (
            <a href={to(item.href)} class:list={{ current: current(item.href) }} aria-current={current(item.href) ? "page" : undefined} {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}>{item.label}</a>
          )
        )}
      </nav>
      <div class="header-cta">
        <a class="audience" href={to(other.href)}>{other.label}</a>
        <Btn href={APP} ghost>Get the App<Icon name="go" /></Btn>
        <Btn href={LOGIN}>Sign in</Btn>
      </div>
    </div>
  </div>
</header>
