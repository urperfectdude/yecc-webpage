---
// Home page: the SHERPA capabilities as auto-advancing tabs, each with a real SHERPA screenshot.
// The switching and the progress bar are driven by src/scripts/site.js.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Btn from "./Btn.astro";
import Tone from "./Tone.astro";
import { FORM } from "../lib/site";
import manuals from "../assets/sherpa/author-manuals.png";
import videos from "../assets/sherpa/author-process-videos.png";
import byRole from "../assets/sherpa/deliver-by-role.png";

const items = [
  {
    title: "Author manuals",
    text: "Create and govern role-based user manuals aligned with the customer’s configured processes.",
    shot: manuals,
    alt: "SHERPA guide editor showing a numbered step with an annotated Oracle screenshot",
  },
  {
    title: "Author process videos",
    text: "Turn approved procedures into practical walkthroughs users can revisit at the point of need.",
    shot: videos,
    alt: "SHERPA generating a process video with a choice of narration voices",
  },
  {
    title: "Deliver by role",
    text: "Create and assign the courses and learning paths to key users and end users, as per their roles, through SHERPA.",
    shot: byRole,
    alt: "A SHERPA course for buyers, with lesson videos, tests and progress towards a certificate",
  },
];
---
<div class="split" data-accordion>
  <div>
    <h2><Tone text="SHERPA connects content creation| with user adoption." /></h2>
    <p class="lead mt-4">
      SHERPA is more than a static LMS. It is YECC’s authoring and delivery platform for turning implementation knowledge
      into governed user manuals, process videos, and role-based learning experiences.
    </p>
    <div class="accordion">
      {items.map((item, i) => (
        <div class:list={["acc-item", { on: i === 0 }]}>
          <button type="button" aria-expanded={i === 0 ? "true" : "false"}><span>{item.title}</span><Icon name="chevron" /></button>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <div class="btns">
      <Btn href={FORM} arrow>Discuss a SHERPA pilot</Btn>
      <Btn href="/sherpa" ghost>Explore SHERPA</Btn>
    </div>
  </div>
  <div>
    {/* Hidden tabs load up front too, so a screenshot is ready the moment its tab opens. */}
    <div class="stage">
      {items.map((item, i) => (
        <div class:list={["mock", "shot", { on: i === 0 }]}>
          <Image src={item.shot} alt={item.alt} widths={[640, 960, 1280]} sizes="(min-width: 960px) 600px, 100vw" loading="eager" />
        </div>
      ))}
    </div>
    <div class="progress" aria-hidden="true">{items.map(() => <i></i>)}</div>
  </div>
</div>
