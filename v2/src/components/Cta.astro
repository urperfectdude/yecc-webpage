---
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<section class="cta" id="contact">
  <div class="wrap">
    <div class="cta-card">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        <div class="btns"><slot /></div>
      </div>
      <svg class="cta-art mix-blend-multiply" viewBox="0 0 420 260" fill="none" aria-hidden="true">
        <rect y="108" width="420" height="44" fill="#2b72d9" opacity=".85" />
        <path d="M250 -10Q250 130 420 130" stroke="#e53935" stroke-width="44" opacity=".9" />
        <path d="M250 270Q250 130 420 130" stroke="#0d2344" stroke-width="44" opacity=".9" />
      </svg>
    </div>
  </div>
</section>
